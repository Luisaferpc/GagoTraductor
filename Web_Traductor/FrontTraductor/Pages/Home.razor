@page "/"

<div class="container mt-5">
    <div class="p-5 mb-4 bg-light rounded-3 shadow-sm border">
        <div class="container-fluid py-3">
            <h1 class="display-5 fw-bold text-primary">GagoTranslate</h1>
            <p class="col-md-8 fs-4 text-secondary mt-3">
                Sistema de traducción de palabras multilingüe integrado con API backend.
                Gestiona y traduce eficientemente entre español, inglés, francés y alemán.
                <h2>
                    <small class="text-primary">Elaborado por</small><br>
                    Luisa Fernanda Perez Cardona y Estiven Alexis Sanchez Restrepo
                </h2>
            </p>
            <hr class="my-4">
            <p class="mb-4">Selecciona una de las opciones en el menú lateral para comenzar a buscar o traducir.</p>

            <div class="d-flex gap-3">
                <a class="btn btn-primary btn-lg" href="traductor" role="button">Ir al Traductor</a>
                <a class="btn btn-outline-secondary btn-lg" href="palabras" role="button">Consultar Palabras</a>
            </div>
        </div>
    </div>
</div>